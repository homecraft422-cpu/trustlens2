# ==========================================================
# TrustLens2 environment configuration
# Copy this file to `.env` and fill in real values for prod.
# NEVER commit `.env` to source control.
# ==========================================================

# ────────────── SITE ──────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=https://trustlens2.vercel.app
NEXT_PUBLIC_APP_NAME=TrustLens

# Support email shown to users. Used as the default contact-form recipient.
SUPPORT_EMAIL=support@trustlens.ai

# ────────────── AUTHENTICATION ──────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# ────────────── DATABASE ──────────────
# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / Railway).
# Local dev:   postgresql://postgres:postgres@127.0.0.1:5432/trustlens
# Hosted:      postgresql://...?sslmode=require
# Without DATABASE_URL the app falls back to a per-instance file store.
# Sign-in still works but accounts/analyses are NOT shared between instances.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/trustlens

# Custom fallback file path while DATABASE_URL is not configured.
# TRUSTLENS_DATA_FILE=.data/trustlens-store.json

# ────────────── EMAIL (magic-link + transactional) ──────────────
# "console" (default in dev) — logs links to the server console
# "resend"               — uses the Resend HTTP API (RESEND_API_KEY required)
# "smtp"                 — generic SMTP (SMTP_HOST/USER/PASSWORD/SECURE)
EMAIL_PROVIDER=console
EMAIL_FROM=TrustLens <no-reply@trustlens.ai>

# Resend — https://resend.com
# RESEND_API_KEY=

# Generic SMTP (Brevo / Mailgun / Postmark / Gmail-app-password / etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ────────────── DETECTION MODE ──────────────
# "mock"        — built-in LOCAL heuristic engine (free, real metadata + stats)
# "production"  — use real neural APIs (HIVE / SIGHTENGINE). Keys required.
DETECTION_MODE=mock

# Hive AI — https://thehive.ai
# HIVE_API_KEY=
# HIVE_API_BASE_URL=https://api.thehive.ai/api/v2/task/sync
# HIVE_TIMEOUT_MS=60000
# HIVE_MAX_RETRIES=2

# Sightengine — https://sightengine.com
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# SIGHTENGINE_ENDPOINT=https://api.sightengine.com/1.0
# SIGHTENGINE_TIMEOUT_MS=30000
# SIGHTENGINE_MAX_RETRIES=1

# ────────────── REAL FACT-CHECK APIs ──────────────
# Google Fact Check Tools API — https://developers.google.com/fact-check/tools/api
# FREE with an API key (1000s of free requests/day). Used by /api/v1/fact-check.
# GOOGLE_FACTCHECK_API_KEY=

# Fact-check request timeout (ms) and wikipedia fallback toggle.
# FACTCHECK_TIMEOUT_MS=12000
# FACTCHECK_WIKIPEDIA_FALLBACK=true

# ────────────── URL CHECKER (SSRF protection) ──────────────
# URLCHECK_BLOCK_PRIVATE=true blocks private/loopback IPs (default).
# URLCHECK_MAX_REDIRECTS=3
# URLCHECK_TIMEOUT_MS=12000

# ────────────── CONTACT FORM ──────────────
# Recipient for the contact form. Defaults to SUPPORT_EMAIL.
# CONTACT_RECIPIENT=support@trustlens.ai
# CONTACT_RATE_LIMIT_HOUR=10

# ────────────── ADVERTISING ──────────────
# Master switch for all ad networks. Default ON in production, OFF in dev.
# NEXT_PUBLIC_ADS_ENABLED=true

# Google AdSense — match this to <meta name="google-adsense-account"> in
# src/app/layout.tsx AND ads.txt at the site root. Without a real value,
# the AdSense auto-ads script does not load.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Adsterra popunder (OPT-IN ONLY; pop-unders violate Google AdSense policies).
# NEXT_PUBLIC_ADSTERRA_POPUNDER_ENABLED=false
# NEXT_PUBLIC_ADSTERRA_SOCIALBAR_ENABLED=true
# NEXT_PUBLIC_ADSTERRA_BANNER160_INVOKE_URL=https://www.highperformanceformat.com/9d435794af3e7655ec34febe818d78f7/invoke.js

# ────────────── USAGE LIMITS ──────────────
# Defaults shown match the public docs.
# GUEST_IMAGE_LIMIT=10
# GUEST_VIDEO_LIMIT=5
# GUEST_AUDIO_LIMIT=5
# USER_IMAGE_LIMIT=10
# USER_VIDEO_LIMIT=5
# USER_AUDIO_LIMIT=5

# ────────────── NODE ENVIRONMENT ──────────────
NODE_ENV=development
