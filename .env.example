# ===========================================
# TrustLens2 Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ===========================================
# DATABASE (Required)
# ===========================================
# PostgreSQL connection string. REQUIRED in production — accounts, sessions,
# magic-link tokens, analyses and usage counters all live here.
#
# Local:   postgresql://postgres:postgres@127.0.0.1:5432/trustlens
# Hosted:  Neon / Supabase / Vercel Postgres (usually needs ?sslmode=require)
#
# After setting this, run:  npm run db:migrate  (then: npm run db:check)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/trustlens

# ── Development fallback ──
# If DATABASE_URL is unset, a per-instance file store is used so the app still
# boots. Sign-in works, but analyses/reports are NOT shared between instances
# and are lost on redeploy. Never rely on this in production.
TRUSTLENS_PERSIST_FALLBACK=true
# Optional custom path for the local fallback store:
# TRUSTLENS_DATA_FILE=.data/trustlens-store.json

# ===========================================
# AUTHENTICATION (Required)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public app URL used inside email verification links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional canonical server URL when public URL differs.
# APP_URL=https://trustlens2.vercel.app

# ===========================================
# EMAIL / MAGIC-LINK AUTH
# ===========================================
# EMAIL_PROVIDER=console logs links locally. Use resend or smtp in production.
EMAIL_PROVIDER=console
EMAIL_FROM=TrustLens <no-reply@trustlens.ai>
SUPPORT_EMAIL=support@trustlens.ai

# Resend: https://resend.com
# RESEND_API_KEY=

# Generic SMTP (Gmail app password, Brevo, Postmark, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ===========================================
# DETECTION MODE
# ===========================================
# "mock" = Use demo data (no API calls, free)
# "production" = Use real APIs (requires API keys)
DETECTION_MODE=mock

# ===========================================
# HIVE AI API (Optional - for production)
# ===========================================
# Get your API key: https://thehive.ai
HIVE_API_KEY=
HIVE_API_BASE_URL=https://api.thehive.ai/api/v2/task/sync
HIVE_TIMEOUT_MS=60000
HIVE_MAX_RETRIES=2

# ===========================================
# SIGHTENGINE API (Optional - for production)
# ===========================================
# Get your API credentials: https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_ENDPOINT=https://api.sightengine.com/1.0
SIGHTENGINE_TIMEOUT_MS=30000
SIGHTENGINE_MAX_RETRIES=1

# ===========================================
# USAGE LIMITS
# ===========================================
GUEST_ANALYSIS_LIMIT=5
USER_ANALYSIS_LIMIT=50

# ===========================================
# APP CONFIGURATION
# ===========================================
# Your app URL (for CORS and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# ===========================================
# STORAGE (Optional - for cloud storage)
# ===========================================
# STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=trustlens-uploads
# AWS_REGION=us-east-1

# ===========================================
# LOGGING (Optional)
# ===========================================
# SENTRY_DSN=
# LOG_LEVEL=info

# ===========================================
# DETECTION (Optional)
# ===========================================
# "mock" (default) = built-in LOCAL heuristic engine: real EXIF/metadata +
# statistical analysis of every uploaded file. Deterministic (same file →
# same report), free, no API keys needed.
# "production" = use neural APIs below when keys are present.
# DETECTION_MODE=mock
# HIVE_API_KEY=
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=

# Guest (no sign-in) analysis limits. Defaults are generous so visitors can
# actually try the tool: 10 images, 5 videos, 5 audios.
# GUEST_IMAGE_LIMIT=10
# GUEST_VIDEO_LIMIT=5
# GUEST_AUDIO_LIMIT=5

# ===========================================
# ADSTERRA ADS (Optional)
# ===========================================
# All ad units are configured in src/lib/ads.ts.
#
# Master switch. Default: ads are ON in production and OFF in development
# (never generate ad impressions from localhost — Adsterra flags that as
# invalid traffic). Force-enable locally to test with real ads:
# NEXT_PUBLIC_ADS_ENABLED=true
#
# Optional override for the 160x300 banner loader, if your Adsterra dashboard
# shows a different invoke.js domain than the default highperformanceformat.com:
# NEXT_PUBLIC_ADSTERRA_BANNER160_INVOKE_URL=https://www.highperformanceformat.com/9d435794af3e7655ec34febe818d78f7/invoke.js

