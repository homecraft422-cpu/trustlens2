# ===========================================
# TrustLens2 Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ===========================================
# DATABASE (Required)
# ===========================================
# Option 1: PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/trustlens

# Development fallback (used automatically when DATABASE_URL is not set)
# Accounts and sessions are persisted to .data/trustlens-store.json.
# Set to false only when you explicitly want an ephemeral in-memory store.
TRUSTLENS_PERSIST_FALLBACK=true
# Optional custom path for the local fallback store:
# TRUSTLENS_DATA_FILE=.data/trustlens-store.json

# ===========================================
# AUTHENTICATION (Required)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public app URL used inside email verification links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional canonical server URL when public URL differs.
# APP_URL=https://trustlens2.vercel.app

# ===========================================
# EMAIL / MAGIC-LINK AUTH
# ===========================================
# EMAIL_PROVIDER=console logs links locally. Use resend or smtp in production.
EMAIL_PROVIDER=console
EMAIL_FROM=TrustLens <no-reply@trustlens.ai>
SUPPORT_EMAIL=support@trustlens.ai

# Resend: https://resend.com
# RESEND_API_KEY=

# Generic SMTP (Gmail app password, Brevo, Postmark, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ===========================================
# DETECTION MODE
# ===========================================
# "mock" = Use demo data (no API calls, free)
# "production" = Use real APIs (requires API keys)
DETECTION_MODE=mock

# ===========================================
# HIVE AI API (Optional - for production)
# ===========================================
# Get your API key: https://thehive.ai
HIVE_API_KEY=
HIVE_API_BASE_URL=https://api.thehive.ai/api/v2/task/sync
HIVE_TIMEOUT_MS=60000
HIVE_MAX_RETRIES=2

# ===========================================
# SIGHTENGINE API (Optional - for production)
# ===========================================
# Get your API credentials: https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_ENDPOINT=https://api.sightengine.com/1.0
SIGHTENGINE_TIMEOUT_MS=30000
SIGHTENGINE_MAX_RETRIES=1

# ===========================================
# USAGE LIMITS
# ===========================================
GUEST_ANALYSIS_LIMIT=5
USER_ANALYSIS_LIMIT=50

# ===========================================
# APP CONFIGURATION
# ===========================================
# Your app URL (for CORS and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# ===========================================
# STORAGE (Optional - for cloud storage)
# ===========================================
# STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=trustlens-uploads
# AWS_REGION=us-east-1

# ===========================================
# LOGGING (Optional)
# ===========================================
# SENTRY_DSN=
# LOG_LEVEL=info
